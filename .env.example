# Sollelio Partner OS — client environment.
#
# Copy to `.env.local` for local development. Every value here is PUBLIC: Vite
# inlines `VITE_*` variables into the browser bundle.
#
# Privileged secrets are NEVER listed here and never prefixed `VITE_`. The
# service-role key and the Events V1 integration secret are configured only as
# Supabase Edge Function secrets (see supabase/README.md).

# The Partner OS Supabase project for this environment. Partner OS has its own
# project; it never points at the Sollelio Events V1 project
# (04_TECHNICAL_ARCHITECTURE.md §3).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-the-local-anon-key

# local | staging | production — surfaces the active environment in the UI and logs.
VITE_APP_ENV=local
